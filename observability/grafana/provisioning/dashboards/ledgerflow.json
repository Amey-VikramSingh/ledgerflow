{
  "title": "LedgerFlow",
  "uid": "ledgerflow",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "Request rate (RED)",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(ledgerflow_http_request_duration_seconds_count[1m])) by (route)" }]
    },
    {
      "title": "p95 latency", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(ledgerflow_http_request_duration_seconds_bucket[5m])) by (le, route))" }]
    },
    {
      "title": "Outbox lag (s)", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "ledgerflow_outbox_lag_seconds" }]
    },
    {
      "title": "Webhook deliveries", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(ledgerflow_webhook_deliveries_total[5m])) by (status)" }]
    }
  ]
}
