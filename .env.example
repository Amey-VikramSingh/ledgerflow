NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledgerflow
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Auth — generate: openssl rand -base64 48
# The value below is for LOCAL DEVELOPMENT ONLY; the app refuses to start with
# it when NODE_ENV=production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string-min-32-chars

# AES-256-GCM key (32 bytes, base64) for secrets stored in the database, such
# as webhook signing secrets. Dev-only value; rejected when NODE_ENV=production.
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=bGVkZ2VyZmxvdy1kZXYtb25seS1rZXktMzJieXRlcyE=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Worker / webhooks
OUTBOX_POLL_INTERVAL_MS=1000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000

# Rate limiting
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SEC=60
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_DURATION_SEC=60

# Cache
CACHE_TTL_SECONDS=30

# Observability (set OTEL_ENABLED=true when a collector is running)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ledgerflow
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9100

# Security
# Reverse proxies in front of the app (Render: 2, Fly.io/one load balancer: 1).
TRUST_PROXY_HOPS=1
# Bearer token for the API's /metrics. In production /metrics is disabled
# unless this is set (min 16 chars).
# METRICS_TOKEN=
# Allow webhook URLs on private/internal addresses. Defaults to true outside
# production, false in production. Never set true in production (SSRF).
# WEBHOOK_ALLOW_PRIVATE_URLS=false
